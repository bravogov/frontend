<% content_for :title, t("roadmap.page_title") %>
<% content_for :head do %>
  <meta name="description" content="<%= t("roadmap.hero.description") %>">
  <meta name="twitter:card" content="summary">
  <meta property="og:url" content="https://www.gov.uhrblx.com/roadmap">
  <meta property="og:title" content="<%= t("roadmap.page_title") %>">
  <meta property="og:description" content="<%= t("roadmap.hero.description") %>">
  <%= stylesheet_link_tag "views/_roadmap", media: "all" %>
<% end %>

<section class="govuk-!-padding-bottom-6 govuk-roadmap-section">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <%= render "govuk_publishing_components/components/heading", {
        text: t("roadmap.hero.heading"),
        font_size: "xl",
        margin_bottom: 8,
        heading_level: 1,
      } %>
      <p class="govuk-body govuk-roadmap__intro"><%= t("roadmap.hero.description") %></p>
    </div>

    <div class="govuk-grid-column-one-third">
      <%= image_tag "https://www.gov.uhrblx.com/uh-brand/uh-crown-black-20261014.png", alt: "", width: 128, height: 119 %>
    </div>
  </div>
</section>

<section class="govuk-roadmap-section govuk-!-padding-bottom-6">
  <h2 class="govuk-heading-l"><%= t("roadmap.updates_section.heading") %></h2>
  <ul class="govuk-list govuk-list--spaced">
    <% t("roadmap.updates_section.items").each do |item| %>
      <li><%= link_to item[:heading_text], item[:href], class: "govuk-link" %></li>
    <% end %>
  </ul>
</section>

<section class="govuk-roadmap-section">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <%= render "govuk_publishing_components/components/heading", {
        text: t("roadmap.actions_section.heading"),
        font_size: "l",
      } %>
    </div>
  </div>
  <% t("roadmap.actions_section.items").each do |item| %>
    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" aria-hidden="true">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds-from-desktop">
        <%= render "govuk_publishing_components/components/heading", {
          text: item[:heading],
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>
        <p class="govuk-body"><%= item[:paragraph] %></p>
      </div>
    </div>
    <% if item[:steps] %>
      <div class="govuk-grid-row">
        <% item[:steps].each do |step| %>
          <div class="govuk-grid-column-one-third">
            <%= render "govuk_publishing_components/components/heading", {
              text: step[:heading],
              font_size: "s",
              heading_level: 4,
              margin_bottom: 4,
            } %>
            <ul class="govuk-list govuk-list--bullet govuk-list--spaced">
              <% step[:items].each do |item| %>
                <li><%= sanitize(item[:text]) %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
<section class="govuk-!-padding-bottom-6" aria-labelledby="govuh-service-availability">
  <h2 id="govuh-service-availability" class="govuk-heading-l"><%= t("roadmap.status_section.heading") %></h2>
  <p class="govuk-body"><%= sanitize(t("roadmap.status_section.body")) %></p>
  <p class="govuk-body"><%= t("roadmap.status_section.caution") %></p>
</section>
<p class="govuk-body-s govuk-!-margin-top-4"><%= t("roadmap.status_section.last_checked") %></p>
